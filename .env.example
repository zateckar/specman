
# LLM gateway (Anthropic Messages API shape, Bearer auth)
LLM_API_KEY=
LLM_URL=https://xxx/v1/messages

# Model used for structured (tool) calls.
LLM_MODEL=primary

# Model used for prose generation. Long context helps whole-document coherence.
LLM_PROSE_MODEL=primary

# Extra substrings that mark an HTTP 400 from this gateway as worth retrying
# rather than as a malformed request. Comma-separated; leave empty unless you
# have one. The client already retries the two failures generic to this API
# shape; this is for a backend of your own that rejects requests another backend
# accepts, which is a fact about your deployment and belongs here rather than in
# the source or the README.
# LLM_RETRYABLE_400=

# How long a gateway call may go without sending anything before it is given up
# on, in milliseconds. Long enough for a model that reasons before its first
# word; without a limit, a stalled call held the turn for ever.
# LLM_IDLE_TIMEOUT_MS=180000

# Gemini fallback provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Bootstrap password for the built-in admin account
ADMIN_PASSWORD=

# SQLite database path
DATABASE_PATH=data/specman.db

# OIDC (optional — leave unset to use local accounts only)
# OIDC_ISSUER=https://your-oidc-provider.com/realms/your-realm
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# PUBLIC_URL=http://localhost:5173

# --- Behind an authenticating reverse proxy -------------------------------
#
# When the proxy has already authenticated the caller it passes on who they are,
# and Specman signs them in with no login page:
#
#   X-Forwarded-User                 the account the proxy authenticated
#   X-Forwarded-Email                their address
#   X-Forwarded-Preferred-Username   the name they are known by, if different
#
# READ THIS BEFORE DEPLOYING. A header is not a credential — it is a string the
# caller chose. This is safe only while BOTH of these hold:
#
#   1. The proxy OVERWRITES these headers on every request it forwards. A proxy
#      that merely adds them lets a client send their own.
#   2. Nothing else can reach this application's port.
#
# If either fails, anyone can sign in as anyone with a single curl. Setting
# PROXY_AUTH_TRUSTED_IPS is what turns assumption 2 into something checked here
# rather than believed about the network. With it unset, any caller may assert an
# identity and the server warns loudly on every boot.
#
# Header sign-in never grants administrator rights: people arrive as ordinary
# users and an administrator grants rights on the People page. Those rights are
# honoured through the header only while PROXY_AUTH_TRUSTED_IPS is set; without
# it, administrators sign in with a password or the company account.

# On unless set to false. An installation with no proxy sends none of these
# headers, so leaving it on changes nothing there.
# PROXY_AUTH_ENABLED=true

# Comma-separated addresses permitted to assert X-Forwarded-User. Empty means
# any caller may. Set this to your proxy's address.
# PROXY_AUTH_TRUSTED_IPS=10.0.0.4

# Where the proxy ends its own session. Without it, the header offers no sign-out
# button, because there is no session here to end.
# PROXY_AUTH_LOGOUT_URL=https://gateway.example.com/oauth2/sign_out
